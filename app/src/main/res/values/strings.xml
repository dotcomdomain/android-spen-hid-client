    <!-- Info ("About") Screen -->
    <string name="info">About</string>

    <string name="info_icon_description">App icon (Keyboard)</string>
    <string name="info_description">This app allows you to use your phone to act as a USB keyboard and mouse without
        requiring any software on the connected device, allowing it to even work in the BIOS/UEFI of the connected
        device!
    </string>
    <string name="info_source_code_url" translatable="false">https://github.com/Arian04/android-hid-client</string>

    <!-- Help Screen -->
    <string name="help">Help</string>

    <string name="help_faq_q1">How do I use the app?</string>
    <string name="help_faq_a1">• Touch &amp; S Pen: Interact with the main surface using finger touch or S Pen.\n\n• Keyboard: Tap the keyboard icon for the phone keyboard, or hold it to open the full USB keyboard.</string>

    <string name="help_faq_spen_title">S Pen Modes</string>
    <string name="help_faq_spen_content">Put the pen near the screen, and hold down the pen\'s button to select a different mode.\n\n• Hover: Cursor tracks the pen in the air. Tapping down performs clicks.\n\n• Mouse: Cursor moves when the pen touches and drags across the surface.\n\n• Hybrid: Absolute digitizer mapping with pressure sensitivity for drawing.</string>

    <string name="help_faq_touchpad_title">Touchpad Gestures</string>
    <string name="help_faq_touchpad_content">• One finger: Slide to move cursor. Tap to left-click.\n\n• Drag &amp; select: Double tap and hold down on the second tap to drag / select.\n\n• Two fingers: Tap to right-click. Slide up or down to scroll.</string>

    <string name="help_faq_q2">Direct Input (Keyboard)</string>
    <string name="help_faq_a2">Tap the keyboard icon to use the phone keyboard. Hold the icon to open a full desktop layout with function, modifier, navigation, number pad, and media keys. Keystrokes are sent directly over USB.</string>

    <string name="help_faq_setup_title">Prerequisites &amp; Setup</string>
    <string name="help_faq_setup_content">Connect your phone to your PC via USB. Ensure your device is rooted with USB Gadget (ConfigFS) support. Check the Troubleshooting menu in the top-right corner to verify system health.</string>

    <string name="help_faq_q5">Feedback &amp; Bug Reports</string>
    <string name="help_faq_a5">You can submit bug reports and feature requests on <a href="https://github.com/Arian04/android-hid-client/issues">GitHub</a>.</string>

